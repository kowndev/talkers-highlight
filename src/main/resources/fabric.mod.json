{
	"schemaVersion": 1,
	"id": "talkershighlight",
	"version": "${version}",
	"name": "Talker's Highlight",
	"description": "Client Side Simple Voice Chat Addon, that make it more clearer who is talking",
	"authors": [
		"KownDev"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/talkers-highlight",
		"Ko-fi": "https://ko-fi.com/kowndev",
        "issues": "https://github.com/kowndev/talkers-highlight/issues"
	},
    "custom": {
      "modmenu": {
        "links": {
          "modmenu.kofi": "https://ko-fi.com/kowndev"
        }
      }
    },
	"license": "CC-BY-ND 4.0",
	"icon": "assets/talkershighlight/icon.png",
	"environment": "client",
	"entrypoints": {
		"fabric-datagen": [
			"net.kown.talkershighlight.TalkersHighligthDataGenerator"
		],
        "client": [
          "net.kown.talkershighlight.TalkersHighlightClient"
        ],
        "modmenu": [
          "net.kown.talkershighlight.ModMenuApiImpl"
        ],
        "voicechat": [
          "net.kown.talkershighlight.bridge.VoiceChatPluginV1"
        ]
	},
	"mixins": [
		"talkershighligth.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
        "voicechat": ">=1.21.1-2.5.0",
        "yet_another_config_lib_v3": ">=3.6.0"
	}
}